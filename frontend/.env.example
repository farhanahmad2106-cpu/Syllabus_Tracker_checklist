# =====================================================================
# Syllabus Tracker Frontend - Environment Configuration Example
# =====================================================================

# For Web / PWA development with local Vite proxy (defaults to '/api' if omitted):
# VITE_API_BASE_URL=

# For Native Mobile Builds (Capacitor Android / iOS):
# When building for native mobile or testing on physical devices/emulators,
# provide the absolute URL of the backend API server.
#
# Android Emulator host loopback:
# VITE_API_BASE_URL=http://10.0.2.2:8000/api
#
# iOS Simulator / Local machine:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
#
# Physical device on local Wi-Fi:
# VITE_API_BASE_URL=http://192.168.1.100:8000/api
#
# Production / Staging deployment:
# VITE_API_BASE_URL=https://api.yourdomain.com/api

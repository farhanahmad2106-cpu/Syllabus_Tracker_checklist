# Backend Configuration
DATABASE_URL=sqlite:///./data/syllabus_tracker.db
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=120
EXTRACTION_RETRY_BUDGET=2
MAX_UPLOAD_SIZE_BYTES=26214400
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Android Release Signing Configuration (Local only - NEVER commit real credentials)
ANDROID_KEYSTORE_PATH=C:\Users\username\syllabus-release-key.jks
ANDROID_KEYSTORE_PASSWORD=your_keystore_password
ANDROID_KEY_ALIAS=syllabus-key
ANDROID_KEY_PASSWORD=your_key_password

# Android Build Tools & Release Artifact Configuration
ANDROID_BUILD_TOOLS_DIR=C:\Users\username\AppData\Local\Android\Sdk\build-tools\35.0.0
ANDROID_APK_RELEASE_DIR=frontend\android\app\build\outputs\apk\release
ANDROID_RELEASE_APK_NAME=SyllabusTracker-v1.0.0-release.apk
ANDROID_RELEASE_APK_SHA256=
ANDROID_AAB_RELEASE_DIR=frontend\android\app\build\outputs\bundle\release
ANDROID_RELEASE_AAB_NAME=SyllabusTracker-v1.0.0-release.aab
ANDROID_RELEASE_AAB_SHA256=
